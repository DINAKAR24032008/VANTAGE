datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String                 @id @default(uuid())
  name             String
  email            String                 @unique
  passwordHash     String
  role             String                 @default("learner") // admin, trainer, learner
  department       String                 @default("General")
  jobRole          String                 @default("Learner")
  gender           String                 @default("other") // male, female, other
  avatar           String                 @default("{\"type\":\"initials\",\"bgColor\":\"#163016\"}") // JSON string
  phone            String?                @unique
  phoneVerified    Boolean                @default(false)
  phoneVerifiedAt  DateTime?
  timezone         String                 @default("Asia/Kolkata")
  createdAt        DateTime               @default(now())
  profile          CompetencyProfile?
  userProfile      UserProfile?
  skills           UserSkill[]
  achievements     Achievement[]
  experiences      Experience[]
  notifications    Notification[]
  notificationPref NotificationPreference?
  notificationLogs NotificationLog[]
  enrollments      Enrollment[]
  attempts         AssessmentAttempt[]
  certificates     Certificate[]
  courses          Course[]               @relation("TrainerCourses")
  forumPosts       ForumPost[]
}

model UserProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  username            String?   @unique
  accountVisibility   String    @default("PUBLIC") // PUBLIC, PRIVATE
  followersCount      Int       @default(0)
  followingCount      Int       @default(0)
  lastUsernameChange  DateTime?
  usernameChangeCount Int       @default(0)
  fullName            String
  dateOfBirth         DateTime?
  country             String    @default("India")
  state               String?
  city                String    @default("")
  profession          String    @default("OTHER") // STUDENT, WORKING_PROFESSIONAL, FREELANCER, JOB_SEEKER, ENTREPRENEUR, OTHER
  highestDegree       String    @default("NONE") // HIGH_SCHOOL, DIPLOMA, BACHELORS, MASTERS, DOCTORATE, OTHER, NONE
  fieldOfStudy        String?
  institution         String?
  graduationYear      Int?
  company             String?
  jobTitle            String?
  yearsOfExperience  String?
  bio                 String?
  linkedinUrl         String?
  showcaseVisible     Boolean   @default(true)
  linkedinVisible     Boolean   @default(true)
  locationVisible     Boolean   @default(true)
  educationVisible    Boolean   @default(true)
  profileCompleted    Boolean   @default(false)
  profileCompletedAt  DateTime?
  streakCount         Int       @default(0)
  lastActiveDate      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([fullName])
  @@index([username])
  @@index([profession])
  @@index([country])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  status      String   @default("ACCEPTED") // ACCEPTED, PENDING
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([status])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model FollowRateLimit {
  id          String   @id @default(uuid())
  userId      String   @unique
  windowStart DateTime @default(now())
  count       Int      @default(0)
}

model SearchRateLimit {
  id          String   @id @default(uuid())
  userId      String   @unique
  windowStart DateTime @default(now())
  count       Int      @default(0)
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  level     String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED
  source    String   @default("SELF") // SELF, VANTAGE
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Achievement {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  organization String
  type         String   @default("OTHER") // AWARD, PROJECT, PUBLICATION, HACKATHON, CERTIFICATION, OTHER
  description  String?
  date         DateTime?
  link         String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

model Experience {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle        String
  company         String
  employmentType  String    @default("Full-time")
  startDate       DateTime
  endDate         DateTime? // null = current
  description     String?
  createdAt       DateTime  @default(now())
}

model OtpCode {
  id         String    @id @default(uuid())
  userId     String?
  phone      String
  codeHash   String
  purpose    String // REGISTER, LOGIN, VERIFY_PHONE
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  ipAddress  String?
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // ENROLLMENT, DAILY_REMINDER, SYSTEM, NEW_FOLLOWER, FOLLOW_REQUEST, FOLLOW_ACCEPTED
  title     String
  message   String
  courseId  String?
  actionUrl String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model NotificationLog {
  id                String   @id @default(uuid())
  userId            String
  channel           String // IN_APP, SMS
  recipient         String // phone or userId
  message           String
  provider          String // CONSOLE, TWILIO, MSG91, FAST2SMS
  providerMessageId String?
  status            String // SENT, FAILED, SKIPPED, QUEUED
  sentAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
}

model NotificationPreference {
  id                   String  @id @default(uuid())
  userId               String  @unique
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  inAppEnabled         Boolean @default(true)
  smsEnabled           Boolean @default(false)
  dailyReminderEnabled Boolean @default(true)
  reminderTime         String  @default("09:00")
  timezone             String  @default("Asia/Kolkata")
  quietHoursStart      String  @default("22:00")
  quietHoursEnd        String  @default("07:00")
  lastReminderSentOn   String?

  @@index([userId])
}

model Competency {
  id          String                @id @default(uuid())
  name        String                @unique
  category    String // Programming, Software Development, etc.
  description String
  courseTags  CourseCompetencyTag[]
}

model CompetencyProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills    String // JSON string: [{ competencyId, competencyName, currentLevel }]
  updatedAt DateTime @updatedAt
}

model Course {
  id              String                @id @default(uuid())
  title           String
  description     String
  trainerId       String
  trainer         User                  @relation("TrainerCourses", fields: [trainerId], references: [id])
  contentUrl      String? // Primary video/file URL or mock S3 URL
  thumbnailUrl    String?
  modules         String // JSON string: [{ id, title, duration, videoUrl, notes, order }]
  difficultyLevel String                @default("Beginner") // Beginner, Intermediate, Advanced
  status          String                @default("draft") // draft, published
  createdAt       DateTime              @default(now())
  competencyTags  CourseCompetencyTag[]
  enrollments     Enrollment[]
  assessments     Assessment[]
  certificates    Certificate[]
  forumPosts      ForumPost[]
}

model CourseCompetencyTag {
  id           String     @id @default(uuid())
  courseId     String
  competencyId String
  targetLevel  Int        @default(1) // Level this course elevates the learner to (1-5)
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([courseId, competencyId])
}

model Enrollment {
  id               String    @id @default(uuid())
  userId           String
  courseId         String
  status           String    @default("not_started") // not_started, in_progress, completed
  progressPercent  Int       @default(0)
  completedModules String    @default("[]") // JSON string of module IDs
  enrolledAt       DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  completedAt      DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Assessment {
  id            String              @id @default(uuid())
  courseId      String
  moduleId      String? // null for course-level assessment, or moduleId for per-module quiz
  passThreshold Int                 @default(70) // Percentage (e.g. 70%)
  questions     String // JSON string: [{ id, question, options: string[], correctIndex: number, explanation?: string }]
  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts      AssessmentAttempt[]

  @@index([courseId, moduleId])
}

model AssessmentAttempt {
  id           String     @id @default(uuid())
  userId       String
  assessmentId String
  score        Int // Percentage score achieved
  passed       Boolean
  answers      String // JSON string of user selected options
  attemptedAt  DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model Certificate {
  id                String   @id @default(uuid())
  userId            String
  courseId          String
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  certificateUrl    String?
  verificationHash  String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model ForumPost {
  id           String      @id @default(uuid())
  courseId     String?
  authorId     String
  parentPostId String?
  title        String? // For root threads
  body         String
  isPinned     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  course       Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author       User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentPost   ForumPost?  @relation("PostThread", fields: [parentPostId], references: [id], onDelete: Cascade)
  replies      ForumPost[] @relation("PostThread")
}
