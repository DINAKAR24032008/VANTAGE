# =========================================================
# VANTAGE APPLICATION CONFIGURATION
# =========================================================
PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# =========================================================
# SMS PROVIDER SELECTION
# Options: CONSOLE | TWILIO | MSG91 | FAST2SMS
# Default for local development: CONSOLE (outputs OTP to terminal stdout)
# =========================================================
SMS_PROVIDER=CONSOLE

# ---------------------------------------------------------
# OPTION A (RECOMMENDED FOR INDIA): MSG91 OTP API
# Note: TRAI regulation requires DLT Registration in India.
# ---------------------------------------------------------
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_dlt_registered_template_id
MSG91_SENDER_ID=VANTAG

# ---------------------------------------------------------
# OPTION B: TWILIO VERIFY / MESSAGES API
# Note: Trial accounts require pre-verifying recipient numbers
# in Twilio Console -> Verified Caller IDs.
# ---------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ---------------------------------------------------------
# OPTION C: FAST2SMS (INDIA QUICK ROUTE)
# ---------------------------------------------------------
FAST2SMS_API_KEY=your_fast2sms_api_key

# ---------------------------------------------------------
# SCHEDULER & DEMO MODE
# ---------------------------------------------------------
REMINDER_CRON_ENABLED=true
DEMO_MODE=true
